# Web local. En Coolify configurá SITE_URL, SITE_INDEXABLE y PUBLIC_SERRANA_API_BASE como Buildtime.
SITE_URL=http://localhost:4321
SITE_INDEXABLE=false

# Origen público de la API, sin /api ni barra final. En blanco se usa el proxy del sitio.
PUBLIC_SERRANA_API_BASE=

# Destino del proxy de Astro en desarrollo y preview. Compose ya configura Nginx.
SERRANA_BACKEND_URL=http://127.0.0.1:5000
