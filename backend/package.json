{
  "name": "serrana-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "tsc -p tsconfig.json && node scripts/check-knowledge.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run tests/unit",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
