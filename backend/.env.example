# API local. En Coolify la imagen usa NODE_ENV=production, HOST=0.0.0.0 y PORT=4319.
NODE_ENV=development
HOST=127.0.0.1
PORT=4319
# Orígenes web exactos, separados por comas y sin barra final. En producción usá HTTPS.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:8080,http://127.0.0.1:8080
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=deepseek-v4.1-flash
# En Coolify cargalo como secreto de Runtime en la API, con Buildtime desactivado.
OLLAMA_API_KEY=
SERRANA_REQUESTS_PER_MINUTE=30
