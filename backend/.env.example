# Runtime de Serrana en Coolify. Agregá la clave desde la configuración del recurso.
FLASK_ENV=production
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=https://manantialesserranos.uy
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
# En Coolify cargalo como secreto de Runtime en la API, con Buildtime desactivado.
OLLAMA_API_KEY=
SERRANA_REQUESTS_PER_MINUTE=30
SERRANA_DIAGNOSTICS=false
