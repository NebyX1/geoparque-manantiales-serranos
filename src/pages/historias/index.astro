---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/brand/Photo.astro';
import { articles } from '../../data/stories';
const stories = Object.entries(articles);
---

<BaseLayout
  title="Lecturas ambientales y geoeducación · Manantiales Serranos"
  description="Comprendé la geología, las cuencas, la biodiversidad y las comunidades del Geoparque con lecturas y propuestas de aprendizaje ambiental."
>
  <section class="editorial-page">
    <p class="eyebrow">Ambiente, patrimonio y aprendizaje</p>
    <h1>Comprender para conservar.</h1>
    <p class="lead">
      Ocho lecturas para relacionar rocas, agua, seres vivos y comunidades. Cada tema propone
      preguntas y formas de aprender desde el aula o en una actividad coordinada en el territorio.
    </p>
    <div class="stories-grid">
      {stories.map(([slug, story], index) => (
        <article class="story-card reveal">
          <a class="story-image" href={`/historias/${slug}/`} aria-label={`Leer ${story.title}`}>
            <Photo assetKey={story.image} alt={story.title} />
          </a>
          <div class="story-card-content">
            <h2>
              <a href={`/historias/${slug}/`}>{story.title}</a>
            </h2>
            <p>{story.lead}</p>
            <span class="story-index">
              {String(index + 1).padStart(2, '0')} / {String(stories.length).padStart(2, '0')}
            </span>
            <a class="story-cta" href={`/historias/${slug}/`}>
              Leer y aprender
              <svg class="icon" aria-hidden="true">
                <use href="#i-arrow" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="visit-note">
      Las lecturas se apoyan en los materiales documentales del Geoparque. Podés consultar sus
      <a href="/inicio/#documentacion">fuentes de referencia</a> y preparar una
      <a href="/inicio/#aprender">actividad educativa</a>.
    </p>
  </section>
</BaseLayout>
