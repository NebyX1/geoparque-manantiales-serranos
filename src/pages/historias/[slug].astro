---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/brand/Photo.astro';
import PhotoCredit from '../../components/brand/PhotoCredit.astro';
import { articles } from '../../data/stories';
import type { GeologicalStory } from '../../types/geopark';
import { breadcrumbs } from '../../lib/seo';
import { absoluteUrl } from '../../lib/urls';
export function getStaticPaths() {
  return Object.entries(articles).map(([slug, story]) => ({
    params: { slug },
    props: { story, slug },
  }));
}
interface Props {
  story: GeologicalStory;
  slug: string;
}
const { story, slug } = Astro.props;
---

<BaseLayout
  title={`${story.title} · Manantiales Serranos`}
  description={story.lead}
  structuredData={[
    breadcrumbs([
      { name: 'Inicio', path: '/inicio/' },
      { name: 'Lecturas ambientales', path: '/historias/' },
      { name: story.title, path: `/historias/${slug}/` },
    ]),
    {
      '@context': 'https://schema.org',
      '@type': ['Article', 'LearningResource'],
      name: story.title,
      headline: story.title,
      description: story.lead,
      url: absoluteUrl(`/historias/${slug}/`),
      inLanguage: 'es-UY',
      learningResourceType: 'Lectura temática',
      educationalUse: 'Educación ambiental e interpretación del patrimonio',
    },
  ]}
>
  <article class="editorial-page story-page">
    <nav class="breadcrumbs" aria-label="Ubicación">
      <a href="/inicio/">Inicio</a> / <a href="/historias/">Lecturas ambientales</a>
    </nav>
    <p class="eyebrow">{story.eyebrow}</p>
    <h1>{story.title}</h1>
    <p class="lead">{story.lead}</p>
    <Photo
      assetKey={story.image}
      profile="reading"
      alt={story.title}
      class="reading-image"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <PhotoCredit assetKey={story.image} />
    <div class="article-reading">
      {story.sections.map(([heading, text]) => (
        <section>
          <h2>{heading}</h2>
          <p>{text}</p>
        </section>
      ))}
      <nav class="related-items" aria-label="Continuar aprendiendo">
        <a href="/historias/">Más lecturas ambientales ↗</a>
        <a href="/inicio/#documentacion">Materiales de referencia ↗</a>
        <a href="/circuitos/">Itinerarios de aprendizaje ↗</a>
      </nav>
    </div>
  </article>
</BaseLayout>
