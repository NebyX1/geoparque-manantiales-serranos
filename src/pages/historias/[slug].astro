---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/brand/Photo.astro';
import { articles } from '../../data/stories';
import type { GeologicalStory } from '../../types/geopark';
import { breadcrumbs } from '../../lib/seo';
export function getStaticPaths() {
  return Object.entries(articles).map(([slug, story]) => ({
    params: { slug },
    props: { story, slug },
  }));
}
interface Props {
  story: GeologicalStory;
  slug: string;
}
const { story, slug } = Astro.props;
---

<BaseLayout
  title={`${story.title} · Manantiales Serranos`}
  description={story.lead}
  structuredData={[
    breadcrumbs([
      { name: 'Inicio', path: '/' },
      { name: 'Historias', path: '/historias/' },
      { name: story.title, path: `/historias/${slug}/` },
    ]),
  ]}
>
  <article class="editorial-page story-page">
    <nav class="breadcrumbs" aria-label="Ubicación">
      <a href="/">Inicio</a> / <a href="/historias/">Historias</a>
    </nav>
    <p class="eyebrow">{story.eyebrow}</p>
    <h1>{story.title}</h1>
    <p class="lead">{story.lead}</p>
    <Photo
      assetKey={story.image}
      alt={story.title}
      class="reading-image"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="article-reading">
      {story.sections.map(([heading, text]) => (
        <section>
          <h2>{heading}</h2>
          <p>{text}</p>
        </section>
      ))}
      <a class="text-link" href="/historias/">
        Más historias ↗
      </a>
    </div>
  </article>
</BaseLayout>
