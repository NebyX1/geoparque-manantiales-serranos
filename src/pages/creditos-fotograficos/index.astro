---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/brand/Photo.astro';
import { referenceImage } from '../../data/assets';
import { placeById } from '../../data/geosites';
import {
  placePhotoInventory,
  editorialPhotoInventory,
  photoLabel,
  placeCoverKey,
} from '../../data/place-photos';
const photos = [...placePhotoInventory, ...editorialPhotoInventory];
---

<BaseLayout
  title="Fotografías y fuentes · Manantiales Serranos"
  description="Autores, fuentes, licencias e imágenes de referencia del Geoparque Manantiales Serranos."
>
  <article class="editorial-page">
    <p class="eyebrow">El territorio, con referencias</p>
    <h1>Fotografías y fuentes.</h1>
    <p class="lead">
      Las imágenes del sitio web y del recorrido inmersivo comparten esta selección de los 61
      lugares.
    </p>
    <p>
      Cuando no contamos con una fotografía terrestre identificada, mostramos una fotografía aérea
      de IDE de 2017–2018. Las versiones de publicación tienen su fuente y, cuando está disponible,
      un enlace a la imagen de referencia.
    </p>
    <ul class="photo-audit-list">
      {photos.map((photo) => {
        const place = placeById.get(photo.id)!;
        const cover = placeCoverKey(photo.key);
        return (
          <li
            id={photo.key}
            class:list={['photo-audit-item', { 'photo-audit-source': cover !== photo.key }]}
          >
            {cover === photo.key && (
              <div>
                <Photo
                  assetKey={photo.key}
                  profile="editorial"
                  alt={photo.alt}
                  class="photo-audit-image"
                  sizes="(max-width: 620px) 90vw, 460px"
                />
              </div>
            )}
            <div>
              <p class="eyebrow">
                GMS-{String(photo.id).padStart(2, '0')}
                {(photo.key === 'aguas' || photo.key.endsWith('-portada')) && ' · portada'}
              </p>
              <h2>
                <a href={`/lugares/${place.slug}/`}>{place.name}</a>
              </h2>
              {photoLabel(photo) && <strong class="photo-label">{photoLabel(photo)}</strong>}
              <p>{photo.caption}</p>
              <p>
                <strong>Crédito:</strong> {photo.credit}.
              </p>
              <p>{photo.evidence}</p>
              {photo.limitations && <p>{photo.limitations}</p>}
              <p>
                <a href={photo.sourcePage} target="_blank" rel="noopener noreferrer">
                  Consultar la fuente ↗
                </a>
                {photo.licenseUrl && (
                  <>
                    {' '}
                    ·{' '}
                    <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">
                      {photo.license}
                    </a>
                  </>
                )}
              </p>
              {cover !== photo.key && (
                <p>
                  <a href={`#${cover}`}>Ver encuadre de publicación ↓</a>
                </p>
              )}
              {'referenceFile' in photo && photo.referenceFile && (
                <p class="photo-audit-original">
                  <a
                    href={referenceImage(photo.referenceFile).src}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Abrir imagen de referencia ↗
                  </a>
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </article>
</BaseLayout>
