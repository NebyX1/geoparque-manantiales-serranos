---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/brand/Photo.astro';
import { FavoritesButton } from '../../components/islands/FavoritesButton';
import { places } from '../../data/geosites';
import { placeSchema, breadcrumbs } from '../../lib/seo';
import type { GeoparkPlace } from '../../types/geopark';
export function getStaticPaths() {
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}
interface Props {
  place: GeoparkPlace;
}
const { place } = Astro.props;
const nearby = places
  .filter((item) => item.region === place.region && item.id !== place.id)
  .slice(0, 4);
const structuredData = [
  placeSchema(place),
  breadcrumbs([
    { name: 'Inicio', path: '/' },
    { name: 'Lugares', path: '/lugares/' },
    { name: place.name, path: `/lugares/${place.slug}/` },
  ]),
];
---

<BaseLayout title={place.seo.title} description={place.seo.description} {structuredData}>
  <article class="place-page">
    <div class="detail-hero">
      <Photo
        assetKey={place.image}
        alt={place.images[0]?.alt || place.name}
        loading="eager"
        fetchpriority="high"
        sizes="100vw"
        transition:name={`place-${place.slug}`}
      />
      <span class="detail-photo-caption">{place.images[0]?.alt}</span>
    </div>
    <div class="detail-main">
      <nav class="breadcrumbs" aria-label="Ubicación">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/lugares/">Lugares</a>
        <span>/</span>
        <span>{place.name}</span>
      </nav>
      <div class="eyebrow">
        GMS-{String(place.id).padStart(2, '0')} · {place.categoryRaw}
        {place.international && ' · Valor científico internacional'}
      </div>
      <h1 class="detail-title">{place.name}</h1>
      <p class="detail-tagline">{place.tagline}</p>
      <div class="detail-grid">
        <div class="detail-body">
          <p class="detail-description">{place.summary}</p>
          <p>{place.intro}</p>
          {place.blocks.map((block) =>
            block.heading ? <h2>{block.text}</h2> : <p>{block.text}</p>,
          )}
          {place.relationsRaw && (
            <>
              <h2>Conexiones del territorio</h2>
              <p>{place.relationsRaw}</p>
            </>
          )}
          <h2>Más cerca de acá</h2>
          <div class="related-items">
            {nearby.map((item) => (
              <a href={`/lugares/${item.slug}/`}>{item.name} ↗</a>
            ))}
          </div>
        </div>
        <aside class="detail-side">
          <h2>Planeá tu visita.</h2>
          <span class="status">{place.status}</span>
          <p>{place.zone}</p>
          <p>{place.statusRaw}</p>
          <FavoritesButton id={place.id} name={place.name} compact={false} client:load />
          {place.channel && (
            <a
              class="btn outline"
              href={place.channel.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {place.channel.label} ↗
            </a>
          )}
          <a class="text-link" href={`/lugares/${place.slug}.md`}>
            Descargar esta ficha ↓
          </a>
          <a class="text-link" href="/explorar/">
            Volver al atlas ↗
          </a>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
