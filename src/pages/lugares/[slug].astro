---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/brand/Photo.astro';
import PhotoCredit from '../../components/brand/PhotoCredit.astro';
import { FavoritesButton } from '../../components/islands/FavoritesButton';
import { places } from '../../data/geosites';
import { photoForDisplay } from '../../data/place-photos';
import { placePhotoSizes } from '../../lib/image-sizing';
import { detailPhotoPosition } from '../../lib/images';
import { photoProfiles } from '../../lib/photo-profiles.mjs';
import { placeSchema, breadcrumbs } from '../../lib/seo';
import type { GeoparkPlace } from '../../types/geopark';
import { learningLens } from '../../lib/learning';
export function getStaticPaths() {
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}
interface Props {
  place: GeoparkPlace;
}
const { place } = Astro.props;
const coverPhoto = photoForDisplay(place.id);
const { width: coverWidth, height: coverHeight } = photoProfiles['place-cover'];
const coverSizes = placePhotoSizes(coverWidth, coverHeight);
const coverPosition = detailPhotoPosition(coverPhoto.key);
const learning = learningLens(place);
const nearby = places
  .filter((item) => item.region === place.region && item.id !== place.id)
  .slice(0, 4);
const structuredData = [
  placeSchema(place),
  breadcrumbs([
    { name: 'Inicio', path: '/inicio/' },
    { name: 'Atlas del patrimonio', path: '/lugares/' },
    { name: place.name, path: `/lugares/${place.slug}/` },
  ]),
];
---

<BaseLayout
  title={place.seo.title}
  description={place.seo.description}
  {structuredData}
  serranaPlace={place}
>
  <article class="place-page">
    <div class="detail-hero">
      <Photo
        assetKey={coverPhoto.key}
        profile="place-cover"
        alt={place.images[0]?.alt || place.name}
        loading="eager"
        fetchpriority="high"
        sizes={coverSizes}
        style={coverPosition && `object-position: ${coverPosition}`}
        transition:name={`place-${place.slug}`}
      />
      <span class="detail-photo-caption">{coverPhoto.caption}</span>
    </div>
    <div class="detail-main">
      <PhotoCredit assetKey={coverPhoto.key} />
      <nav class="breadcrumbs" aria-label="Ubicación">
        <a href="/inicio/">Inicio</a>
        <span>/</span>
        <a href="/lugares/">Atlas del patrimonio</a>
        <span>/</span>
        <span>{place.name}</span>
      </nav>
      <div class="eyebrow">
        GMS-{String(place.id).padStart(2, '0')} · {place.categoryRaw}
        {place.international && ' · Valor científico internacional'}
      </div>
      <h1 class="detail-title">{place.name}</h1>
      <p class="detail-tagline">{place.tagline}</p>
      <div class="detail-grid">
        <div class="detail-body">
          <p class="detail-description">{place.intro}</p>
          <section class="learning-note" aria-label="Claves para aprender">
            <span class="eyebrow">{learning.topic}</span>
            <h2>{learning.question}</h2>
            <p>{learning.observe}</p>
            <h3>Registrar y cuidar</h3>
            <p>{learning.care}</p>
            <a class="text-link" href={`/historias/${learning.article}/`}>
              Profundizar en este tema ↗
            </a>
          </section>
          <h2>Información del lugar</h2>
          {place.blocks.map((block) =>
            block.heading ? <h2>{block.text}</h2> : <p>{block.text}</p>,
          )}
          {place.relationsRaw && (
            <>
              <h2>Conexiones del territorio</h2>
              <p>{place.relationsRaw}</p>
            </>
          )}
          <h2>Otras fichas de la misma zona</h2>
          <div class="related-items">
            {nearby.map((item) => (
              <a href={`/lugares/${item.slug}/`}>{item.name} ↗</a>
            ))}
          </div>
        </div>
        <aside class="detail-side">
          <h2>Antes de observar en el lugar</h2>
          <span class="status">{place.status}</span>
          <p>{place.zone}</p>
          <p>{place.statusRaw}</p>
          <p>
            Estudiar esta ficha no requiere una visita. Para una salida de campo, confirmá acceso,
            acompañamiento y condiciones adecuadas para el grupo.
          </p>
          <FavoritesButton id={place.id} name={place.name} compact={false} client:load />
          {place.channel && (
            <a
              class="btn outline"
              href={place.channel.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {place.channel.label} ↗
            </a>
          )}
          <a
            class="text-link"
            href={`/lugares/${place.slug}.pdf`}
            download={`${place.slug}.pdf`}
            data-astro-reload
          >
            Descargar ficha en PDF ↓
          </a>
          <a class="text-link" href="/explorar/">
            Volver al atlas ↗
          </a>
          <a class="text-link" href="/inicio/#documentacion">
            Consultar los documentos fuente ↗
          </a>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
