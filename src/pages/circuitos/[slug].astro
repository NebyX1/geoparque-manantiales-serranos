---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/brand/Photo.astro';
import PhotoCredit from '../../components/brand/PhotoCredit.astro';
import { circuits } from '../../data/circuits';
import { placeById } from '../../data/geosites';
import { absoluteUrl } from '../../lib/urls';
import { breadcrumbs } from '../../lib/seo';
import type { Circuit } from '../../types/geopark';
export function getStaticPaths() {
  return circuits.map((circuit) => ({ params: { slug: circuit.id }, props: { circuit } }));
}
interface Props {
  circuit: Circuit;
}
const { circuit } = Astro.props;
const structuredData = [
  breadcrumbs([
    { name: 'Inicio', path: '/inicio/' },
    { name: 'Itinerarios de aprendizaje', path: '/circuitos/' },
    { name: circuit.name, path: `/circuitos/${circuit.id}/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: circuit.name,
    itemListElement: circuit.places.map((id, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: placeById.get(id)!.name,
      url: absoluteUrl(`/lugares/${placeById.get(id)!.slug}/`),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: circuit.name,
    description: circuit.text,
    url: absoluteUrl(`/circuitos/${circuit.id}/`),
    inLanguage: 'es-UY',
    learningResourceType: 'Itinerario de aprendizaje',
    educationalUse: 'Observación ambiental y preparación de actividades educativas',
  },
];
---

<BaseLayout
  title={`${circuit.name} · Manantiales Serranos`}
  description={circuit.text}
  {structuredData}
>
  <article class="editorial-page story-page">
    <nav class="breadcrumbs" aria-label="Ubicación">
      <a href="/inicio/">Inicio</a> / <a href="/circuitos/">Itinerarios de aprendizaje</a>
    </nav>
    <p class="eyebrow">
      Secuencia orientativa · {circuit.days} {circuit.days === 1 ? 'jornada' : 'jornadas'} ·{' '}
      {circuit.kicker}
    </p>
    <h1>{circuit.name}</h1>
    <p class="lead">{circuit.text}</p>
    <Photo
      assetKey={circuit.image}
      profile="reading"
      alt={circuit.imageContext ? 'Paisaje de Lavalleja' : circuit.name}
      class="reading-image"
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
    />
    <PhotoCredit assetKey={circuit.image} />
    <div class="article-reading">
      {circuit.blocks.map((block) => (
        <section>
          <h2>
            Jornada {block.day} · {block.title}
          </h2>
          <p>{block.text}</p>
          <div class="related-items">
            {block.ids.map((id) => (
              <a href={`/lugares/${placeById.get(id)!.slug}/`}>{placeById.get(id)!.name} ↗</a>
            ))}
          </div>
        </section>
      ))}
      <button class="btn" data-add-route={circuit.id}>
        Guardar itinerario de aprendizaje ↗
      </button>
      <p class="visit-note">
        Las jornadas organizan una propuesta didáctica que se adapta al grupo. Las lecturas y fichas
        pueden trabajarse desde el aula. Cualquier salida requiere acordar accesos, acompañamiento y
        condiciones con los responsables de cada sitio.
      </p>
      <p class="visit-note">
        Consultá las <a href="/inicio/#documentacion">fuentes documentales</a> y las
        <a href="/historias/conservacion/">orientaciones para conservar el patrimonio</a> antes de
        preparar una actividad.
      </p>
      <a class="text-link" href="/circuitos/">
        Más itinerarios de aprendizaje ↗
      </a>
    </div>
  </article>
</BaseLayout>
