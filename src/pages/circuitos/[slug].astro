---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/brand/Photo.astro';
import { circuits } from '../../data/circuits';
import { placeById } from '../../data/geosites';
import { absoluteUrl } from '../../lib/urls';
import { breadcrumbs } from '../../lib/seo';
import type { Circuit } from '../../types/geopark';
export function getStaticPaths() {
  return circuits.map((circuit) => ({ params: { slug: circuit.id }, props: { circuit } }));
}
interface Props {
  circuit: Circuit;
}
const { circuit } = Astro.props;
const structuredData = [
  breadcrumbs([
    { name: 'Inicio', path: '/' },
    { name: 'Circuitos', path: '/circuitos/' },
    { name: circuit.name, path: `/circuitos/${circuit.id}/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: circuit.name,
    itemListElement: circuit.places.map((id, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: placeById.get(id)!.name,
      url: absoluteUrl(`/lugares/${placeById.get(id)!.slug}/`),
    })),
  },
];
---

<BaseLayout
  title={`${circuit.name} · Manantiales Serranos`}
  description={circuit.text}
  {structuredData}
>
  <article class="editorial-page story-page">
    <p class="eyebrow">
      {circuit.days} días · {circuit.kicker}
    </p>
    <h1>{circuit.name}</h1>
    <p class="lead">{circuit.text}</p>
    <Photo
      assetKey={circuit.image}
      alt={circuit.imageContext ? 'Paisaje de Lavalleja' : circuit.name}
      class="reading-image"
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
    />
    <div class="article-reading">
      {circuit.blocks.map((block) => (
        <section>
          <h2>
            Día {block.day} · {block.title}
          </h2>
          <p>{block.text}</p>
          <div class="related-items">
            {block.ids.map((id) => (
              <a href={`/lugares/${placeById.get(id)!.slug}/`}>{placeById.get(id)!.name} ↗</a>
            ))}
          </div>
        </section>
      ))}
      <button class="btn" data-add-route={circuit.id}>
        Guardar esta escapada ↗
      </button>
      <p class="visit-note">Coordiná reservas y accesos con los lugares que elijas visitar.</p>
      <a class="text-link" href="/circuitos/">
        Más escapadas ↗
      </a>
    </div>
  </article>
</BaseLayout>
