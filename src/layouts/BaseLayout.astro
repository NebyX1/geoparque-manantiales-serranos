---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/layout/Navbar.astro';
import MobileNavigation from '../components/layout/MobileNavigation.astro';
import Footer from '../components/layout/Footer.astro';
import Dialogs from '../components/layout/Dialogs.astro';
import AccessibilityDialog from '../components/layout/AccessibilityDialog.astro';
import IconSprite from '../components/decorative/IconSprite.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { canonicalPlaces } from '../data/geosites';
import { placePhotoPresentation, browserPhotoMetadata } from '../data/place-photos';
import { geopark } from '../data/geopark';
import { clientPhotoVariants } from '../lib/images';
import { heroImages } from '../lib/hero-images';
import { absoluteUrl } from '../lib/urls';
import originalMap from '../assets/images/territory-map/mapa-original.webp';
import '../styles/global.css';
import '../styles/cards-art.css';
import '../styles/environment.css';
import '../styles/accessibility.css';
import acumin from '../assets/fonts/acumin-variable.woff2?url';
interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>[];
}
const { title, description, structuredData = [] } = Astro.props;
const browserPlaces = canonicalPlaces.map((place) => ({
  ...place,
  ...placePhotoPresentation(place.id),
}));
const photoVariants = await clientPhotoVariants(browserPlaces.map(({ image }) => image));
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const home = /^\/inicio\/?$/.test(Astro.url.pathname);
const heroSources = home ? await heroImages('arequita-rio') : null;
const common = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Manantiales Serranos',
    url: absoluteUrl('/'),
  },
  ...(home
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Place',
          name: 'Geoparque Mundial UNESCO Manantiales Serranos',
          description:
            'Un territorio de 2.010 km² en Lavalleja para la conservación, la educación ambiental y el desarrollo sostenible de sus comunidades.',
          url: absoluteUrl('/'),
          sameAs: 'https://www.unesco.org/en/iggp/manantiales-serranos-unesco-global-geopark',
        },
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          itemListElement: geopark.places
            .filter((place) => place.featured)
            .map((place, index) => ({
              '@type': 'ListItem',
              position: index + 1,
              name: place.name,
              url: absoluteUrl(`/lugares/${place.slug}/`),
            })),
        },
      ]
    : []),
];
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#214b37" />
    <link rel="preload" href={acumin} as="font" type="font/woff2" crossorigin />
    {heroSources && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        media="(min-width: 621px)"
        imagesrcset={heroSources.desktop}
        imagesizes={heroSources.desktopSizes}
        fetchpriority="high"
      />
    )}
    {heroSources && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        media="(max-width: 620px)"
        imagesrcset={heroSources.mobile}
        imagesizes={heroSources.mobileSizes}
        fetchpriority="high"
      />
    )}
    <SeoHead {title} {description} />
    <ClientRouter />
    <StructuredData data={[...common, ...structuredData]} />
    <slot name="head" />
  </head>
  <body class:list={['has-site-header', { 'route-page': !home }]}>
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <IconSprite />
    <Navbar />
    <MobileNavigation />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="toast" id="toast" popover="manual" role="status" aria-live="polite"></div>
    <Dialogs />
    <AccessibilityDialog motion />
    <script
      id="page-data"
      type="application/json"
      set:html={json({
        ...geopark,
        places: browserPlaces,
        photos: browserPhotoMetadata,
        photoVariants,
        mapOriginal: originalMap.src,
      })}
    />
    <noscript>
      <p class="planner-fallback">
        Explorá los <a href="/lugares/">61 lugares</a>, las <a href="/historias/">historias</a> y
        los <a href="/circuitos/">circuitos</a>.{' '}
        <a href="/guia.md" download>
          Llevá la guía de bolsillo.
        </a>
      </p>
    </noscript>
    <script>
      import '../features/site/lifecycle.js';
    </script>
  </body>
</html>
