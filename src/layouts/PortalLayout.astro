---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/seo/SeoHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { absoluteUrl } from '../lib/urls';
import '../styles/fonts.css';
import displayFont from '../assets/fonts/barlow-800.woff2?url';
import bodyFont from '../assets/fonts/montserrat-variable.woff2?url';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  clientNavigation?: boolean;
}
const { title, description, bodyClass = '', clientNavigation = true } = Astro.props;
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#173d30" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <SeoHead {title} {description} />
    <StructuredData
      data={[
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: 'Manantiales Serranos',
          url: absoluteUrl('/'),
        },
      ]}
    />
    {clientNavigation && <ClientRouter />}
    <slot name="head" />
  </head>
  <body class:list={['portal-body', bodyClass]}>
    <slot />
    <script>
      import '../features/site/lifecycle.js';
    </script>
  </body>
</html>

<style is:global>
  .portal-body {
    margin: 0;
    font-family: 'Montserrat Variable', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
</style>
