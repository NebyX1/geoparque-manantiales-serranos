---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { assets } from '../../data/assets';
import { responsiveWidths } from '../../lib/image-sizing';
import { photoForAsset, photoFit } from '../../data/place-photos';
import '../../styles/photos.css';
interface Props {
  assetKey: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  id?: string;
  avif?: boolean;
  decoding?: 'async' | 'sync' | 'auto';
  quality?: number;
  mobileSource?: Pick<ImageMetadata, 'width' | 'height'>;
}
const {
  assetKey,
  alt,
  loading = 'lazy',
  sizes = '(max-width: 620px) 100vw, 50vw',
  avif = false,
  decoding = 'async',
  quality = 92,
  mobileSource,
  ...rest
} = Astro.props;
const asset = assets[assetKey];
if (!asset) throw new Error(`Unknown image asset: ${assetKey}`);
const photo = photoForAsset(assetKey);
const description = alt === '' ? '' : photo?.alt || alt;
const metadata = photo
  ? {
      'data-photo-kind': photo.kind,
      'data-photo-fit': photoFit(photo),
      'data-photo-key': photo.key,
      'data-photo-width': asset.width,
      'data-photo-height': asset.height,
      ...(mobileSource
        ? {
            'data-photo-mobile-width': mobileSource.width,
            'data-photo-mobile-height': mobileSource.height,
          }
        : {}),
      style: `--photo-width:${asset.width}px;--photo-height:${asset.height}px;${mobileSource ? `--photo-mobile-width:${mobileSource.width}px;--photo-mobile-height:${mobileSource.height}px;` : ''}`,
    }
  : {};
const local = 'format' in asset;
const widths = responsiveWidths(asset.width);
---

{local && avif ? (
  <Picture
    src={asset as ImageMetadata}
    alt={description}
    widths={widths}
    sizes={sizes}
    formats={['avif']}
    quality={quality}
    fallbackFormat="webp"
    loading={loading}
    decoding={decoding}
    {...metadata}
    {...rest}
  />
) : local ? (
  <Image
    src={asset as ImageMetadata}
    alt={description}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={quality}
    loading={loading}
    decoding={decoding}
    {...metadata}
    {...rest}
  />
) : (
  <img
    src={asset.src}
    width={asset.width}
    height={asset.height}
    alt={description}
    loading={loading}
    decoding={decoding}
    {...metadata}
    {...rest}
  />
)}
