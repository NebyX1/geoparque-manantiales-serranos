---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { assets } from '../../data/assets';
import { responsiveWidths } from '../../lib/image-sizing';
interface Props {
  assetKey: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  id?: string;
  avif?: boolean;
  decoding?: 'async' | 'sync' | 'auto';
}
const {
  assetKey,
  alt,
  loading = 'lazy',
  sizes = '(max-width: 620px) 100vw, 50vw',
  avif = false,
  decoding = 'async',
  ...rest
} = Astro.props;
const asset = assets[assetKey] || assets['panorama']!;
const local = 'format' in asset;
const widths = responsiveWidths(asset.width);
---

{local && avif ? (
  <Picture
    src={asset as ImageMetadata}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif']}
    fallbackFormat="webp"
    loading={loading}
    decoding={decoding}
    {...rest}
  />
) : local ? (
  <Image
    src={asset as ImageMetadata}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    loading={loading}
    decoding={decoding}
    {...rest}
  />
) : (
  <img
    src={asset.src}
    width={asset.width}
    height={asset.height}
    alt={alt}
    loading={loading}
    decoding={decoding}
    {...rest}
  />
)}
