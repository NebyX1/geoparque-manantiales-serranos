---
import { Image } from 'astro:assets';
import { brandImages } from '../../data/assets';
import { responsiveWidths } from '../../lib/image-sizing';
import { photoForAsset } from '../../data/place-photos';
import { photoMetadata, standardPhoto, type PhotoProfile } from '../../lib/images';
import '../../styles/photos.css';

interface Props {
  assetKey: string;
  profile?: PhotoProfile;
  alt: string;
  class?: string;
  style?: string | undefined;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  id?: string;
  decoding?: 'async' | 'sync' | 'auto';
}
const {
  assetKey,
  profile,
  alt,
  loading = 'lazy',
  sizes,
  decoding = 'async',
  ...rest
} = Astro.props;
const photo = photoForAsset(assetKey);
if (photo && !profile) throw new Error(`Seleccioná el perfil del componente para ${assetKey}`);
const picture = profile && (await standardPhoto(assetKey, profile));
const brand = brandImages[assetKey];
if (!picture && !brand) throw new Error(`Imagen desconocida: ${assetKey}`);
const description = alt === '' ? '' : photo?.alt || alt;
---

{picture && profile ? (
  <img
    src={picture.src}
    srcset={picture.srcset}
    sizes={sizes ?? picture.sizes}
    width={picture.width}
    height={picture.height}
    alt={description}
    loading={loading}
    decoding={decoding}
    {...photoMetadata(assetKey, profile, picture.width, picture.height)}
    {...rest}
  />
) : (
  <Image
    src={brand!}
    alt={description}
    widths={[...new Set([160, 240, ...responsiveWidths(brand!.width)])].filter(
      (width) => width <= brand!.width,
    )}
    sizes={sizes ?? '(max-width: 620px) 100vw, 50vw'}
    format="webp"
    quality={92}
    loading={loading}
    decoding={decoding}
    {...rest}
  />
)}
