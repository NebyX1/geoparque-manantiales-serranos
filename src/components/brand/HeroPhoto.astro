---
import { heroImages } from '../../lib/hero-images';
import type { HeroAssetKey } from '../../data/hero-assets';
import { photoMetadata } from '../../lib/images';
import '../../styles/photos.css';
interface Props {
  assetKey: HeroAssetKey;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
}
const { assetKey, loading = 'lazy', decoding = 'async', ...attributes } = Astro.props;
const images = await heroImages(assetKey);
const { width, height } = images.desktopAsset;
---

<picture>
  <source
    media="(max-width: 620px)"
    type="image/webp"
    srcset={images.mobile}
    sizes={images.mobileSizes}
  />
  <img
    src={images.fallback}
    srcset={images.desktop}
    {width}
    {height}
    alt=""
    sizes={images.desktopSizes}
    {loading}
    {decoding}
    data-photo-mobile-width={images.mobileAsset.width}
    data-photo-mobile-height={images.mobileAsset.height}
    {...photoMetadata(assetKey, 'hero', width, height)}
    {...attributes}
  />
</picture>
