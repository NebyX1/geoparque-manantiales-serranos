---
import { TripPlanner } from '../islands/TripPlanner';
---

<section aria-labelledby="planner-title" class="planner" id="planificador">
  <div class="section-inner planner-box">
    <div class="planner-intro">
      <div class="eyebrow">
        <svg aria-hidden="true" class="icon">
          <use href="#i-route"></use>
        </svg>
        Cuaderno de campo
      </div>
      <h2 id="planner-title">
        Tu cuaderno
        <br />
        <em>de campo.</em>
      </h2>
      <p>
        Elegí un tema y reuní fichas para trabajar en clase, preparar una salida educativa o
        continuar investigando. Guardá y ordená tu selección sin cuenta; tus preferencias se
        conservan en este navegador.
      </p>
    </div>
    <TripPlanner client:visible />
  </div>
</section>
