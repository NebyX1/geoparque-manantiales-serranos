---
import CircuitCard from '../trip/CircuitCard.astro';
import { circuits } from '../../data/circuits';
---

<section aria-labelledby="routes-title" class="section" id="circuitos">
  <div class="section-inner">
    <div class="eyebrow">
      <span class="chapter">08 /</span>Observar, relacionar y registrar
    </div>
    <div class="section-heading">
      <h2 class="display" id="routes-title">
        Itinerarios
        <br />
        <em>para aprender.</em>
      </h2>
      <p class="section-lead">
        Propuestas de observación para relacionar geología, ambientes y comunidad. Empezá con una
        pregunta, consultá las fichas y registrá lo aprendido. Se pueden preparar desde el aula.
      </p>
    </div>
    <div class="routes-grid">
      {circuits.map((circuit) => (
        <CircuitCard {circuit} />
      ))}
    </div>
    <p class="route-note">
      Los días son una organización orientativa del aprendizaje. Para una salida presencial, acordá
      accesos y acompañamiento con cada responsable y adaptá la propuesta al grupo.
    </p>
  </div>
</section>
