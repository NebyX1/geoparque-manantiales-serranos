        target="_blank"
      >
        <svg aria-hidden="true" class="icon">
          <use href="#i-instagram"></use>
        </svg>
        Manantiales Serranos
        <svg aria-hidden="true" class="icon">
          <use href="#i-arrow"></use>
        </svg>
      </a>
    </div>
  </div>
</section>
