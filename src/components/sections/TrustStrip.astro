---
import Photo from '../brand/Photo.astro';
---

<div aria-label="El Geoparque en cifras" class="trust-strip">
  <Photo alt="UNESCO Geoparque mundial" assetKey="unesco" class="unesco-lock" />
  <p>
    Un patrimonio que conecta
    <br />
    nuestra historia con la del planeta.
  </p>
  <span class="trust-separator"></span>
  <div class="trust-item">
    <div>
      <strong>
        2.010<span style="display:inline;font-size:13px;color:inherit">km²</span>
      </strong>
      <span>de territorio para conocer</span>
    </div>
  </div>
  <span class="trust-separator"></span>
  <div class="trust-item">
    <div>
      <strong>4</strong>
      <span>geositios de valor internacional</span>
    </div>
  </div>
  <span class="trust-separator"></span>
  <div class="trust-item">
    <div>
      <strong>2026</strong>
      <span>designación UNESCO</span>
    </div>
  </div>
</div>
