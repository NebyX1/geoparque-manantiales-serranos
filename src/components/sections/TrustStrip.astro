---
import Photo from '../brand/Photo.astro';
---

<section aria-label="El Geoparque en cifras" class="trust-strip">
  <Photo
    alt="UNESCO Geoparque mundial"
    assetKey="unesco"
    class="unesco-lock"
    sizes="(max-width: 620px) 63px, 80px"
  />
  <p>
    Un patrimonio que conecta
    <br />
    nuestra historia con la del planeta.
  </p>
  <span class="trust-separator"></span>
  <div class="trust-item">
    <div>
      <strong>
        2.010 <span class="trust-unit">km²</span>
      </strong>
      <span>de patrimonio interconectado</span>
    </div>
  </div>
  <span class="trust-separator"></span>
  <div class="trust-item">
    <div>
      <strong>4</strong>
      <span>geositios de valor internacional</span>
    </div>
  </div>
  <span class="trust-separator"></span>
  <div class="trust-item">
    <div>
      <strong>2026</strong>
      <span>designación UNESCO</span>
    </div>
  </div>
</section>
