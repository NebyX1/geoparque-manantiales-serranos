---
import Photo from '../brand/Photo.astro';
import { environmentalAxes, environmentalPurpose } from '../../data/environment';
---

<section class="section environment" id="ambiente" aria-labelledby="environment-title">
  <div class="section-inner">
    <div class="eyebrow">
      <span class="chapter">01 /</span>Comprender las conexiones
    </div>
    <div class="section-heading">
      <h2 class="display" id="environment-title">
        Un territorio.
        <br />
        <em>Todo se relaciona.</em>
      </h2>
      <p class="section-lead">{environmentalPurpose.description}</p>
    </div>
    <div class="knowledge-grid">
      {environmentalAxes.map((axis) => (
        <article class="knowledge-card" id={`eje-${axis.id}`}>
          <div class="knowledge-image">
            <Photo assetKey={axis.image} profile="editorial" alt="" />
          </div>
          <div class="knowledge-copy">
            <p class="eyebrow">{axis.label}</p>
            <h3>{axis.title}</h3>
            <p>{axis.description}</p>
            <p class="knowledge-question">{axis.question}</p>
            <details>
              <summary>Una forma de investigar</summary>
              <p>{axis.action}</p>
            </details>
            <a class="text-link" href={axis.href}>
              Profundizar en este tema ↗
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="environment-source">
      Contenido basado en las presentaciones del Geoparque.{' '}
      <a href="/inicio/#documentacion">Consultar las fuentes ↗</a>
    </p>
  </div>
</section>
