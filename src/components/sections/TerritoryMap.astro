---
import Photo from '../brand/Photo.astro';
---

<section aria-labelledby="map-title" class="section map-section" id="territorio">
  <div class="section-inner">
    <div class="eyebrow">
      <span class="chapter">03 /</span>Un territorio, muchas conexiones
    </div>
    <div class="section-heading">
      <h2 class="display" id="map-title">
        Elegí un punto.
        <br />
        <em>Empezá una historia.</em>
      </h2>
      <p class="section-lead">
        Desde Minas a las sierras, del bosque al manantial. Explorá esta selección en el mapa y abrí
        sus fichas.
      </p>
    </div>
    <div class="map-grid">
      <aside class="map-sidebar">
        <h3>Ocho puertas de entrada</h3>
        <p>
          Elegí un lugar y descubrí
          <br />
          su historia y su entorno.
        </p>
        <ul class="map-list" id="map-list">
          <li>
            <button aria-pressed="true" data-map-place="1">
              <span class="map-index">01</span>
              <span>Cerro Arequita</span>
              <svg aria-hidden="true" class="icon">
                <use href="#i-arrow"></use>
              </svg>
            </button>
          </li>
          <li>
            <button aria-pressed="false" data-map-place="23">
              <span class="map-index">02</span>
              <span>Aguas Blancas</span>
              <svg aria-hidden="true" class="icon">
                <use href="#i-arrow"></use>
              </svg>
            </button>
          </li>
          <li>
            <button aria-pressed="false" data-map-place="31">
              <span class="map-index">03</span>
              <span>Reserva Salus</span>
              <svg aria-hidden="true" class="icon">
                <use href="#i-arrow"></use>
              </svg>
            </button>
          </li>
          <li>
            <button aria-pressed="false" data-map-place="17">
              <span class="map-index">04</span>
              <span>Parque de Minas</span>
              <svg aria-hidden="true" class="icon">
                <use href="#i-arrow"></use>
              </svg>
            </button>
          </li>
          <li>
            <button aria-pressed="false" data-map-place="14">
              <span class="map-index">05</span>
              <span>Salto del Penitente</span>
              <svg aria-hidden="true" class="icon">
                <use href="#i-arrow"></use>
              </svg>
            </button>
          </li>
          <li>
            <button aria-pressed="false" data-map-place="54">
              <span class="map-index">06</span>
              <span>Villa Serrana</span>
              <svg aria-hidden="true" class="icon">
                <use href="#i-arrow"></use>
              </svg>
            </button>
          </li>
          <li>
            <button aria-pressed="false" data-map-place="42">
              <span class="map-index">07</span>
              <span>Minas y sus historias</span>
              <svg aria-hidden="true" class="icon">
                <use href="#i-arrow"></use>
              </svg>
            </button>
          </li>
          <li>
            <button aria-pressed="false" data-map-place="5">
              <span class="map-index">08</span>
              <span>El Destacamento</span>
              <svg aria-hidden="true" class="icon">
                <use href="#i-arrow"></use>
              </svg>
            </button>
          </li>
        </ul>
      </aside>
