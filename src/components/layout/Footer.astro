---
import Photo from '../brand/Photo.astro';
---

<footer class="footer">
  <div class="section-inner">
    <div class="footer-top">
      <p class="footer-title">
        El conocimiento
        <br />
        también <em>cuida.</em>
      </p>
      <nav aria-label="Navegación del pie" class="footer-nav">
        <a href="/inicio/#historia">Historia de la Tierra</a>
        <a href="/inicio/#naturaleza">Agua y biodiversidad</a>
        <a href="/inicio/#aprender">Educación ambiental</a>
        <a href="/inicio/#explorar">Atlas del territorio</a>
        <a href="/inicio/#territorio">Mapa del Geoparque</a>
        <a href="/inicio/#cultura">Patrimonio y comunidad</a>
        <a href="/inicio/#visita">Cuidar el territorio</a>
        <a href="/inicio/#documentacion">Biblioteca documental</a>
        <a href="/experiencia/" data-astro-reload data-astro-prefetch="false">
          Entrar a la experiencia 3D
        </a>
        <a href="/">Elegir cómo explorar</a>
        <a href="/creditos-fotograficos/">Fotografías y fuentes</a>
        <button data-action="privacy">Tu privacidad</button>
      </nav>
    </div>
    <div class="footer-bottom">
      <div class="footer-logo-card">
        <Photo
          alt="Manantiales Serranos Geoparque Mundial de la UNESCO"
          assetKey="brand-c66ec6c0da68"
        />
        <Photo alt="UNESCO Geoparque mundial" assetKey="unesco" />
      </div>
      <p class="footer-small">
        Lavalleja, Uruguay.
        <br />
        Un territorio para comprender la Tierra y cuidar la vida.
        <br />
      </p>
      <button aria-pressed="false" class="motion-btn" id="motion-toggle">
        <svg aria-hidden="true" class="icon">
          <use href="#i-pause"></use>
        </svg>
        <span>Reducir movimiento</span>
      </button>
    </div>
    <svg aria-hidden="true" class="footer-ridges" preserveAspectRatio="none" viewBox="0 0 1400 120">
      <path
        d="M0 107Q150 47 275 98T550 74Q690 -20 820 75T1050 62Q1200 0 1400 61V120H0Z"
        fill="#41623b"
      ></path>
      <path
        d="M0 120Q145 76 255 111T520 88Q710 5 850 94T1140 70Q1230 53 1400 92V120Z"
        fill="#7e9752"
      ></path>
      <path
        d="M0 120Q200 102 350 117T680 101T1050 110T1400 112"
        fill="none"
        stroke="#d4e885"
        stroke-width="1.5"
      ></path>
    </svg>
    <div class="footer-tail">
      <span>MANANTIALES SERRANOS · 2026</span>
      <span>
        Observar y comprender.
        <br />
        Aprender para conservar.
      </span>
    </div>
  </div>
  <a class="round back-top" id="back-top" href="/inicio/#inicio" aria-label="Volver al inicio">
    <svg class="icon" aria-hidden="true">
      <use href="#i-up" />
    </svg>
  </a>
</footer>
