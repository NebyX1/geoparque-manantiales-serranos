---
import Photo from '../brand/Photo.astro';
import TripTrigger from '../trip/TripTrigger.astro';
---

<header class="site-header" id="site-header">
  <a aria-label="Manantiales Serranos, elegir experiencia" class="brand" href="/" data-astro-reload>
    <Photo
      alt="Geoparque Mundial de la UNESCO Manantiales Serranos"
      assetKey="brand-c66ec6c0da68"
    />
  </a>
  <nav aria-label="Navegación principal" class="desktop-nav">
    <a href="/inicio/#historia">
      <span class="nav-number">01</span>La Tierra
    </a>
    <a href="/inicio/#naturaleza">
      <span class="nav-number">02</span>Agua y vida
    </a>
    <a href="/inicio/#aprender">
      <span class="nav-number">03</span>Educación
    </a>
    <a href="/inicio/#explorar">
      <span class="nav-number">04</span>Atlas
    </a>
    <a href="/inicio/#visita">
      <span class="nav-number">05</span>Conservar
    </a>
  </nav>
  <div class="header-actions">
    <button aria-label="Buscar temas y fichas" class="round" data-action="search">
      <svg aria-hidden="true" class="icon">
        <use href="#i-search"></use>
      </svg>
    </button>
    <TripTrigger />
    <button
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú"
      class="round mobile-toggle"
      id="mobile-toggle"
    >
      <svg aria-hidden="true" class="icon">
        <use href="#i-menu"></use>
      </svg>
    </button>
  </div>
  <div aria-hidden="true" class="progress" id="page-progress"></div>
</header>
